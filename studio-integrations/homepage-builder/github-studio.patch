diff --git a/src/editor/hosting.ts b/src/editor/hosting.ts
new file mode 100644
index 0000000..71ed9db
--- /dev/null
+++ b/src/editor/hosting.ts
@@ -0,0 +1,13 @@
+import type { Project } from '../model/types';
+import studioLinks from './legacy-pages.json';
+
+export const githubStudio = import.meta.env?.MODE === 'github-studio';
+export const classicStudio = (page='home') => page === 'home' ? '../?page=home&editor=classic' : '../?page='+encodeURIComponent(page);
+export const legacyPages = studioLinks.map(([id,label]) => [id!,label!] as const);
+export function homepageOnly(project:Project):Project {
+  // Older private-builder backups can contain extra draft pages. Bring the
+  // native homepage and its shared elements over, never create real pages.
+  const homepage=project.site.pages.find(p=>p.id==='page-home');
+  if(!homepage)throw new Error('This backup does not contain the New City Wellness homepage.');
+  return {...project,site:{...project.site,homePageId:homepage.id,pages:[{...homepage,slug:'',parentId:null,hiddenFromNavigation:false}]}};
+}
