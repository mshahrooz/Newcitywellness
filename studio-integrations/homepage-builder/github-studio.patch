diff --git a/tests/hosting.test.ts b/tests/hosting.test.ts
new file mode 100644
index 0000000..6cad927
--- /dev/null
+++ b/tests/hosting.test.ts
@@ -0,0 +1,19 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {classicStudio,homepageOnly,legacyPages} from '../src/editor/hosting';
+import {makeSeedProject} from '../src/model/seed';
+import {newPage} from '../src/model/layout';
+import {projectSchema} from '../src/model/schema';
+
+test('homepage builder keeps the Classic routes and accepts only the native homepage from a backup',()=>{
+ const p=makeSeedProject();const home=p.site.pages[0]!;
+ newPage(p,'Private draft page');
+ const imported=homepageOnly(p);
+ assert.equal(imported.site.pages.length,1);
+ assert.equal(imported.site.homePageId,home.id);
+ assert.equal(p.site.pages.length,2);
+ assert.equal(projectSchema.safeParse(imported).success,true);
+ assert.equal(classicStudio(),'../?page=home&editor=classic');
+ assert.equal(classicStudio('about-us'),'../?page=about-us');
+ assert.equal(legacyPages.length,14);
+});
